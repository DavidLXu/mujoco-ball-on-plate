                pos="0.153987 -0.043690 0.0015" material="target"
                contype="0" conaffinity="0" mass="0"/>
          <geom type="sphere" size="0.0022"
                pos="0.158491 -0.021946 0.0015" material="target"
                contype="0" conaffinity="0" mass="0"/>
        </body>
      </body>
    </body>

    <!-- free-flying ball: everything is resolved through contact -->
    <body name="ball" pos="0.000 0.000 0.6455">
      <freejoint name="ball_free"/>
      <geom name="ball_geom" type="sphere" size="0.025" mass="0.045"
            material="ball" condim="6" friction="1.1 0.0005 0.00005"
            solref="0.0035 1" solimp="0.95 0.99 0.002"/>
      <geom name="ball_mark_a" type="sphere" size="0.0045" pos="0.000 0.000 0.0242"
            mass="0" material="rim" contype="0" conaffinity="0"/>
      <geom name="ball_mark_b" type="sphere" size="0.0045" pos="0.0171 0.0171 0.0121"
            mass="0" material="plate" contype="0" conaffinity="0"/>
      <geom name="ball_mark_c" type="sphere" size="0.0045" pos="-0.0171 -0.0171 0.0121"
            mass="0" material="plate" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="pitch_motor" joint="pitch" gear="1" ctrlrange="-6 6"/>
    <motor name="roll_motor" joint="roll" gear="1" ctrlrange="-6 6"/>
  </actuator>

  <sensor>
    <jointpos name="pitch_pos" joint="pitch"/>
    <jointpos name="roll_pos" joint="roll"/>
    <jointvel name="pitch_vel" joint="pitch"/>
    <jointvel name="roll_vel" joint="roll"/>
    <framepos name="ball_world" objtype="body" objname="ball"/>
    <framelinvel name="ball_linvel" objtype="body" objname="ball"/>
  </sensor>
</mujoco>
